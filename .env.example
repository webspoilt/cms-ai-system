# =============================================================================
# AI-POWERED CMS - ENVIRONMENT CONFIGURATION
# =============================================================================

# Application Settings
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
APP_NAME="AI-Powered Content Management System"
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Database Configuration
# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/ai-cms?authSource=admin
MONGODB_TEST_URI=mongodb://localhost:27017/ai-cms-test

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=password
REDIS_DB=0

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# Password Configuration
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Two-Factor Authentication
TOTP_SECRET_KEY=your-totp-secret-key
TOTP_WINDOW=2

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/linkedin/callback

# =============================================================================
# AI & MACHINE LEARNING SERVICES
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-organization-id
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Cloud Services
GOOGLE_APPLICATION_CREDENTIALS=./config/google-cloud-credentials.json
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_CLOUD_REGION=us-central1

# Hugging Face
HUGGING_FACE_API_KEY=hf_your-hugging-face-api-key
HUGGING_FACE_BASE_URL=https://api-inference.huggingface.co/models

# =============================================================================
# FILE STORAGE & CDN
# =============================================================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-cms-media-bucket
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Alternative: MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-cms-media
MINIO_USE_SSL=false

# Image Processing
IMAGE_MAX_SIZE=10485760
IMAGE_ALLOWED_FORMATS=jpeg,jpg,png,gif,webp,svg
VIDEO_MAX_SIZE=104857600
VIDEO_ALLOWED_FORMATS=mp4,mov,avi,webm

# =============================================================================
# ELASTICSEARCH & SEARCH
# =============================================================================

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=password
ELASTICSEARCH_INDEX_PREFIX=ai-cms
SEARCH_MAX_RESULTS=100
SEARCH_SUGGESTION_LIMIT=10

# =============================================================================
# EMAIL & NOTIFICATION SERVICES
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME="AI CMS"
SMTP_FROM_EMAIL=noreply@ai-cms.com

# SendGrid (Alternative)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@ai-cms.com

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@ai-cms.com

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token
MIXPANEL_API_SECRET=your-mixpanel-api-secret

# PostHog
POSTHOG_API_KEY=phc_your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Security Headers
HELMET_CSP=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
REFERRER_POLICY=strict-origin-when-cross-origin

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_MAX_SIZE=5242880
LOG_FILE_MAX_FILES=5
LOG_DIR=./logs

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# DEPLOYMENT & SCALING
# =============================================================================

# Docker Configuration
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_PREFIX=ai-cms
DOCKER_TAG=latest

# Kubernetes Configuration
KUBERNETES_NAMESPACE=ai-cms
KUBERNETES_REPLICAS=3
KUBERNETES_RESOURCES_CPU=500m
KUBERNETES_RESOURCES_MEMORY=1Gi

# Load Balancer
LOAD_BALANCER_PORT=80
LOAD_BALANCER_HTTPS_PORT=443
SSL_CERT_PATH=/etc/ssl/certs/ai-cms.crt
SSL_KEY_PATH=/etc/ssl/private/ai-cms.key

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================

# Redis Cache Configuration
CACHE_DEFAULT_TTL=3600
CACHE_MAX_KEYS=10000
CACHE_COMPRESSION_LEVEL=6

# CDN Configuration
CDN_BASE_URL=https://cdn.ai-cms.com
CDN_CACHE_TTL=86400
CDN_ALLOWED_DOMAINS=ai-cms.com,www.ai-cms.com

# Frontend Performance
NEXT_PUBLIC_API_TIMEOUT=10000
NEXT_PUBLIC_WEBSOCKET_TIMEOUT=5000
NEXT_PUBLIC_ENABLE_SW=true
NEXT_PUBLIC_SW_CACHE_TIMEOUT=86400

# =============================================================================
# BACKUP & RECOVERY
# =============================================================================

# Database Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups
BACKUP_S3_BUCKET=ai-cms-backups

# File Backup
MEDIA_BACKUP_SCHEDULE=0 3 * * *
MEDIA_BACKUP_RETENTION_DAYS=7

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Development Settings
DEBUG=ai-cms:*
HOT_RELOAD=true
SOURCE_MAPS=true

# Testing Configuration
TEST_DATABASE_URL=mongodb://localhost:27017/ai-cms-test
TEST_CACHE_URL=redis://localhost:6379/15
TEST_TIMEOUT=30000
TEST_PARALLEL=4

# Seed Data
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@ai-cms.com
SEED_ADMIN_PASSWORD=admin123
SEED_SAMPLE_CONTENT=true

# =============================================================================
# INTEGRATIONS & WEBHOOKS
# =============================================================================

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# API Integrations
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
FEATURE_AI_CONTENT_GENERATION=true
FEATURE_REAL_TIME_COLLABORATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_PWA=true
FEATURE_DARK_MODE=true
FEATURE_2FA=true
FEATURE_OAUTH_PROVIDERS=true
FEATURE_FILE_UPLOAD=true
FEATURE_SEARCH_ENGINE=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PUSH_NOTIFICATIONS=true

# Feature Flags for Beta Features
FEATURE_BETA_AI_TRANSLATION=false
FEATURE_BETA_ADVANCED_SEO=false
FEATURE_BETA_CONTENT_APPROVAL=false
FEATURE_BETA_TEAM_PERMISSIONS=false
FEATURE_BETA_API_V2=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================